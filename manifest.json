{
  "manifest_version": 3,
  "name": "Liquid Tab",
  "version": "4.0",
  "description": "A liquid-glass new tab with a Now Island, clock, daily quotes, weather, calendar and a magnifying shortcut dock.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "geolocation",
    "identity"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://www.googleapis.com/*",
    "https://www.bing.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "oauth2": {
    "client_id": "PASTE-YOUR-CLIENT-ID-HERE.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}
