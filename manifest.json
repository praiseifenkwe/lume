{
  "manifest_version": 3,
  "name": "Lume",
  "version": "4.1",
  "description": "A sleek new tab with a live Now Island, clock, daily quotes, weather, custom dock and beautiful rotating backgrounds.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "geolocation",
    "topSites",
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://images.unsplash.com/*",
    "https://ipapi.co/*",
    "https://ipwho.is/*",
    "https://api.bigdatacloud.net/*",
    "https://unavatar.io/*",
    "https://*.google.com/*",
    "https://*.gstatic.com/*",
    "https://icons.duckduckgo.com/*"
  ]
}
